{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lilygo:lilygobox:ota-manifest:1.0",
  "title": "LilygoBox OTA Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "manifestVersion",
    "release",
    "channel",
    "publishTime",
    "targets",
    "files",
    "releaseNotes"
  ],
  "properties": {
    "kind": {
      "const": "lilygobox#otaManifest"
    },
    "manifestVersion": {
      "const": "1.0"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "channel": {
      "enum": [
        "alpha",
        "beta",
        "stable"
      ]
    },
    "publishTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/mapKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "releaseNotes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 127
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "alpha"
          }
        }
      },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "version": {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-alpha\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "beta"
          }
        }
      },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "version": {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-beta\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "stable"
          }
        }
      },
      "then": {
        "properties": {
          "release": {
            "properties": {
              "version": {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "mapKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 30,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(alpha|beta)\\.(0|[1-9][0-9]*))?$"
    },
    "majorMinorVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisherId",
        "deviceId",
        "version"
      ],
      "properties": {
        "publisherId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "chip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "revision"
      ],
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "esp32c5",
            "esp32c6",
            "esp32p4"
          ]
        },
        "revision": {
          "$ref": "#/$defs/majorMinorVersion"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "components"
      ],
      "properties": {
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deviceVersion",
            "chips"
          ],
          "properties": {
            "deviceVersion": {
              "$ref": "#/$defs/majorMinorVersion"
            },
            "chips": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/mapKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/chip"
              }
            }
          }
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/mapKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapKey"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chip",
        "projectName",
        "version",
        "fileName",
        "downloadUrls",
        "sizeBytes",
        "hashes"
      ],
      "properties": {
        "chip": {
          "type": "string",
          "enum": [
            "esp32c5",
            "esp32c6",
            "esp32p4"
          ]
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 159,
          "pattern": "^[a-z0-9][a-z0-9._-]*\\.bin$"
        },
        "downloadUrls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
