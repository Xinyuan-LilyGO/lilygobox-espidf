menu "LilygoBox Configuration"

    choice LILYGO_BOX_DEVICE
        prompt "Select the device to build"
        default LILYGO_BOX_DEVICE_T_DISPLAY_P4

        config LILYGO_BOX_DEVICE_T_DISPLAY_P4
            bool "T-Display-P4"
    endchoice

    choice T_DISPLAY_P4_DEVICE_TYPE
        prompt "T-Display-P4 device type"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default BOARD_TYPE_T_DISPLAY_P4

        config BOARD_TYPE_T_DISPLAY_P4
            bool "T-Display-P4"

        config BOARD_TYPE_T_DISPLAY_P4_KEYBOARD
            bool "T-Display-P4 Keyboard"
    endchoice

    choice T_DISPLAY_P4_DEVICE_VERSION
        prompt "T-Display-P4 device version"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default BOARD_VERSION_T_DISPLAY_P4_V2_0

        config BOARD_VERSION_T_DISPLAY_P4_V1_0
            bool "T-Display-P4 V1.0"

        config BOARD_VERSION_T_DISPLAY_P4_V2_0
            bool "T-Display-P4 V2.0"
    endchoice

    choice SCREEN_TYPE
        prompt "T-Display-P4 screen type"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default SCREEN_TYPE_HI8561

        config SCREEN_TYPE_HI8561
            bool "HI8561"

        config SCREEN_TYPE_RM69A10
            bool "RM69A10"
    endchoice

    choice SCREEN_PIXEL_FORMAT
        prompt "Screen color format"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default SCREEN_PIXEL_FORMAT_RGB565

        config SCREEN_PIXEL_FORMAT_RGB565
            bool "RGB565"

        config SCREEN_PIXEL_FORMAT_RGB888
            bool "RGB888"
    endchoice

    choice CAMERA_TYPE
        prompt "Camera type"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default CAMERA_TYPE_OV2710

        config CAMERA_TYPE_SC2336
            bool "SC2336"

        config CAMERA_TYPE_OV2710
            bool "OV2710"

        config CAMERA_TYPE_OV5645
            bool "OV5645"
    endchoice

    choice CAMERA_PIXEL_FORMAT
        prompt "Camera color format"
        depends on LILYGO_BOX_DEVICE_T_DISPLAY_P4
        default CAMERA_PIXEL_FORMAT_RGB565

        config CAMERA_PIXEL_FORMAT_RGB565
            bool "RGB565"

        config CAMERA_PIXEL_FORMAT_RGB888
            bool "RGB888"
    endchoice

    config LILYGO_BOX_LVGL_DRAW_BUFFER_ROWS
        int "LVGL draw buffer row count"
        range 0 2048
        default 0
        help
            Number of display rows allocated for the LVGL partial draw buffer.
            Use 0 to allocate a full-height draw buffer in PSRAM. T-Display-P4
            defaults to a full-height buffer to match the original LVGL example
            and keep full-screen refreshes in one large flush chunk.

    choice LILYGO_BOX_LOG_LEVEL
        prompt "Select LilygoBox log level"
        default LILYGO_BOX_LOG_LEVEL_INFO

        config LILYGO_BOX_LOG_LEVEL_DEBUG
            bool "Debug"

        config LILYGO_BOX_LOG_LEVEL_INFO
            bool "Info"

        config LILYGO_BOX_LOG_LEVEL_WARNING
            bool "Warning"

        config LILYGO_BOX_LOG_LEVEL_ERROR
            bool "Error"

        config LILYGO_BOX_LOG_LEVEL_NONE
            bool "None"
    endchoice

    config LV_DPI_DEF
        int "Default LVGL dots per inch"
        default 300

    config LV_DEF_REFR_PERIOD
        int "Default LVGL refresh period"
        default 30

    config LV_MEM_SIZE_KILOBYTES
        int "LVGL heap size in kilobytes"
        default 64

    config LV_FS_STDIO_LETTER
        int "LVGL stdio drive letter"
        default 65

    config LV_CACHE_DEF_SIZE
        int "LVGL image cache size"
        default 2799104

endmenu
