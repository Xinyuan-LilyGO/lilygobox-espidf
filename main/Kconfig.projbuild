menu "LilygoBox Configuration"
    config LILYGO_BOX_USB_ETHERNET
        bool
        depends on LILYGO_DEVICE_DRIVER_T_DISPLAY_P4 && LILYGO_DEVICE_DRIVER_DEVICE_VERSION_V2
        default y
        select USB_HOST_HUBS_SUPPORTED
        select USB_HOST_HUB_MULTI_LEVEL
        select USB_HOST_ENABLE_ENUM_FILTER_CALLBACK
        help
            P4 V2 uses the onboard hub and RTL8152B ECM configuration 2.

    choice LILYGO_BOX_LOG_LEVEL
        prompt "Select default LilygoBox log level"
        default LILYGO_BOX_LOG_LEVEL_INFO
        help
            Selects the minimum log level used when the application starts.
            The application can change it later through SetMinimumLogLevel().
        config LILYGO_BOX_LOG_LEVEL_DEBUG
            bool "Debug"
        config LILYGO_BOX_LOG_LEVEL_INFO
            bool "Info"
        config LILYGO_BOX_LOG_LEVEL_WARNING
            bool "Warning"
        config LILYGO_BOX_LOG_LEVEL_ERROR
            bool "Error"
        config LILYGO_BOX_LOG_LEVEL_NONE
            bool "None"
    endchoice

    choice LILYGO_BOX_RELEASE_CHANNEL
        prompt "Select LilygoBox release channel"
        default LILYGO_BOX_RELEASE_CHANNEL_STABLE
        help
            Selects the fixed application release channel used by this build.
            OTA manifests follow the same channel.
            The release lifecycle is Alpha (X.Y.Z-alpha.N), Beta
            (X.Y.Z-beta.N), and Stable (X.Y.Z).
            Production builds must use Stable.
        config LILYGO_BOX_RELEASE_CHANNEL_ALPHA
            bool "Alpha"
        config LILYGO_BOX_RELEASE_CHANNEL_BETA
            bool "Beta"
        config LILYGO_BOX_RELEASE_CHANNEL_STABLE
            bool "Stable"
    endchoice

endmenu
